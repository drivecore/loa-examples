{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client", "@landofassets/runtime/virtual"],
    "paths": { "example-scene": ["./shared/scene.js"] }
  },
  "include": ["shared/**/*.js", "examples/**/*.js"]
}
